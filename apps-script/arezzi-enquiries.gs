/**
 * Arezzi Furniture enquiries — one web app URL for the website.
 * POST saves immediately. GET returns only an opaque receipt status.
 * A daily installable trigger sends one digest for each completed IST day.
 * Run setupArezzi() once as the Google account that owns the spreadsheet.
 */
var AREZZI_CFG = Object.freeze({
  spreadsheetId: '1rSFEo6NyqrNkYtwejABTxCOeGlrtv9NDURQT-4V5JuY',
  sheetId: 2124585196,
  sheetName: 'enquiry sheet',
  timezone: 'Asia/Kolkata',
  recipient: 'sufiayn45666@gmail.com',
  sender: 'arezzifurniture@gmail.com',
  referenceFolder: 'Arezzi Enquiry References'
});

var AREZZI_HEADERS = [
  'Enquiry ID', 'Received At (IST)', 'Date (IST)', 'Client Request ID',
  'Source Page', 'Name', 'Phone', 'District', 'Area / Locality', 'PIN',
  'Furniture Type', 'Home Visit Requested', 'Model', 'Material', 'Colour',
  'Quantity', 'Other Preferences', 'Email', 'Requirements',
  'Reference Image URL', 'Consent', 'Digest Status'
];

// For manual recovery only: enter a yyyy-MM-dd date, then run the wrapper below.
var AREZZI_MANUAL_DIGEST_DATE = '';

var AREZZI_LOGO_BASE64 = '';

function setupArezzi() {
  prepareEnquirySheet_();
  senderOptions_();
  var existing = ScriptApp.getProjectTriggers().filter(function(t) {
    return t.getHandlerFunction() === 'sendDailyDigest';
  });
  if (!existing.length) {
    ScriptApp.newTrigger('sendDailyDigest').timeBased().atHour(1)
      .nearMinute(20).everyDays(1).inTimezone(AREZZI_CFG.timezone).create();
  }
  return 'Ready. One daily digest is scheduled for approximately 1:20 AM IST.';
}

function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) throw Error('Empty request');
    var data = JSON.parse(e.postData.contents);
    validateEnquiry_(data);
    var lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      var sheet = getEnquirySheet_();
      var existing = findRequest_(sheet, data.clientRequestId);
      if (existing) return json_({success:true, referenceId:existing[0], duplicate:true});

      var now = new Date();
      var day = Utilities.formatDate(now, AREZZI_CFG.timezone, 'yyyy-MM-dd');
      var id = nextId_(sheet, day);
      var imageUrl = data.referenceImage ? saveImage_(data.referenceImage, id) : '';
      var row = [
        id, Utilities.formatDate(now, AREZZI_CFG.timezone, 'dd MMM yyyy, hh:mm:ss a'),
        day, String(data.clientRequestId), data.sourcePage, data.name,
        normalizePhone_(data.phone), data.district, data.area, data.pin,
        data.furnitureType, data.guidanceRequested ? 'Yes' : 'No',
        data.model, data.material, data.colour, data.quantity,
        data.customPreference, data.email, data.requirements, imageUrl,
        'Yes', ''
      ].map(safeCell_);
      sheet.appendRow(row);
      SpreadsheetApp.flush();
      return json_({success:true, referenceId:id});
    } finally {
      lock.releaseLock();
    }
  } catch (error) {
    console.error('Arezzi enquiry failed: ' + error);
    // The website confirms success through its separate receipt lookup.
    return json_({success:false, error:'The enquiry could not be saved.'});
  }
}

function doGet(e) {
  var p = e && e.parameter || {};
  var requestId = String(p.receipt || '');
  var callback = String(p.callback || '');
  if (!/^[A-Za-z0-9_-]{8,100}$/.test(requestId) ||
      !/^__arezziReceipt_[A-Za-z0-9_]{8,80}$/.test(callback)) {
    return ContentService.createTextOutput('/* Invalid receipt request */')
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }
  var found = findRequest_(getEnquirySheet_(), requestId);
  // Never return a customer's details from this public lookup.
  var result = {success:!!found, referenceId:found ? String(found[0]) : ''};
  return ContentService.createTextOutput(callback + '(' + JSON.stringify(result) + ');')
    .setMimeType(ContentService.MimeType.JAVASCRIPT);
}

function sendDailyDigest() {
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var sheet = getEnquirySheet_();
    if (sheet.getLastRow() < 2) return 'No enquiries.';
    var rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, AREZZI_HEADERS.length).getDisplayValues();
    var today = Utilities.formatDate(new Date(), AREZZI_CFG.timezone, 'yyyy-MM-dd');
    var groups = {};
    rows.forEach(function(row, i) {
      var day = row[2];
      if (day && day < today && row[21] !== 'SENT' && row[21] !== 'SENDING') {
        (groups[day] = groups[day] || []).push({row:row, sheetRow:i + 2});
      }
    });
    var dates = Object.keys(groups).sort();
    var properties = PropertiesService.getScriptProperties();
    var sent = [];
    dates.forEach(function(day) {
      var key = 'digest:' + day;
      var state = properties.getProperty(key);
      if (state === 'SENT' || state === 'SENDING') return;
      // SENDING is written before Gmail is called. If execution dies during
      // delivery, an automatic retry will not send a possible duplicate.
      properties.setProperty(key, 'SENDING');
      try {
        var batch = groups[day];
        batch.forEach(function(item) { sheet.getRange(item.sheetRow, 22).setValue('SENDING'); });
        SpreadsheetApp.flush();
        sendDigestEmail_(day, batch.map(function(item) { return item.row; }));
        batch.forEach(function(item) { sheet.getRange(item.sheetRow, 22).setValue('SENT'); });
        SpreadsheetApp.flush();
        properties.setProperty(key, 'SENT');
        sent.push(day);
      } catch (err) {
        // A SENDING batch needs inspection in Gmail Sent before manual retry.
        console.error('Digest for ' + day + ' needs review: ' + err);
        throw err;
      }
    });
    return sent.length ? 'Sent digests: ' + sent.join(', ') : 'No unsent completed days.';
  } finally {
    lock.releaseLock();
  }
}

function inspectDigestState(day) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(day)) throw Error('Use yyyy-MM-dd.');
  return PropertiesService.getScriptProperties().getProperty('digest:' + day) || 'NOT_STARTED';
}

function inspectConfiguredDigestDate() {
  return inspectDigestState(AREZZI_MANUAL_DIGEST_DATE);
}

/** Run manually only after checking Gmail Sent for this date. */
function resetDigestAfterReview(day) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(day)) throw Error('Use yyyy-MM-dd.');
  var sheet = getEnquirySheet_();
  var last = sheet.getLastRow();
  if (last > 1) {
    var rows = sheet.getRange(2, 1, last - 1, 22).getDisplayValues();
    rows.forEach(function(row, i) {
      if (row[2] === day && row[21] === 'SENDING') sheet.getRange(i + 2, 22).clearContent();
    });
  }
  PropertiesService.getScriptProperties().deleteProperty('digest:' + day);
}

function resetConfiguredDigestAfterReview() {
  return resetDigestAfterReview(AREZZI_MANUAL_DIGEST_DATE);
}

// Run manually once. Preserve incompatible legacy data in a renamed backup tab.
function prepareEnquirySheet_() {
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var ss = SpreadsheetApp.openById(AREZZI_CFG.spreadsheetId);
    var sheet = ss.getSheetByName(AREZZI_CFG.sheetName) || ss.getSheetById(AREZZI_CFG.sheetId);
    if (sheet && sheet.getLastRow() > 0 && !hasEnquiryHeaders_(sheet)) {
      var backup = 'Enquiry backup ' + Utilities.formatDate(new Date(), AREZZI_CFG.timezone, 'yyyyMMdd-HHmmss');
      var suffix = 1, unique = backup;
      while (ss.getSheetByName(unique)) unique = backup + '-' + suffix++;
      sheet.setName(unique);
      sheet = null;
    }
    if (!sheet) sheet = ss.insertSheet(AREZZI_CFG.sheetName);
    else if (sheet.getName() !== AREZZI_CFG.sheetName) sheet.setName(AREZZI_CFG.sheetName);
    if (sheet.getLastRow() === 0) {
      sheet.getRange(1, 1, 1, AREZZI_HEADERS.length).setValues([AREZZI_HEADERS]);
      sheet.setFrozenRows(1);
      ['C:C','D:D','G:G','J:J'].forEach(function(column) { sheet.getRange(column).setNumberFormat('@'); });
    }
    return sheet;
  } finally { lock.releaseLock(); }
}

function hasEnquiryHeaders_(sheet) {
  return sheet.getRange(1, 1, 1, AREZZI_HEADERS.length).getDisplayValues()[0].join('|') === AREZZI_HEADERS.join('|');
}

function getEnquirySheet_() {
  var ss = SpreadsheetApp.openById(AREZZI_CFG.spreadsheetId);
  var sheet = ss.getSheetByName(AREZZI_CFG.sheetName);
  if (!sheet || !hasEnquiryHeaders_(sheet)) throw Error('Run setupArezzi() once to prepare the enquiry sheet safely. Existing data will be preserved in a backup tab.');
  return sheet;
}

function validateEnquiry_(d) {
  if (!d || typeof d !== 'object') throw Error('Invalid enquiry');
  if (!/^[A-Za-z0-9_-]{8,100}$/.test(String(d.clientRequestId || ''))) throw Error('Invalid request ID');
  if (!d.consent) throw Error('Consent required');
  if (!String(d.name || '').trim() || String(d.name).length > 120) throw Error('Name required');
  var phone = normalizePhone_(d.phone);
  if (phone.length < 7 || phone.length > 15) throw Error('Invalid phone');
  if (!/^[1-9]\d{5}$/.test(String(d.pin || ''))) throw Error('Invalid PIN');
  if (['Sofa','Bed','Table'].indexOf(d.furnitureType) < 0) throw Error('Invalid furniture type');
  if (!String(d.district || '').trim() || !String(d.area || '').trim()) throw Error('Location required');
  if (d.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(d.email))) throw Error('Invalid email');
  ['sourcePage','district','area','model','material','colour','quantity','customPreference','email','requirements'].forEach(function(key) {
    if (String(d[key] || '').length > (key === 'requirements' ? 5000 : 300)) throw Error('Field too long: ' + key);
  });
  if (d.referenceImage && Number(d.referenceImage.size) > 5 * 1024 * 1024) throw Error('Image too large');
}

function findRequest_(sheet, id) {
  if (sheet.getLastRow() < 2) return null;
  var cell = sheet.getRange(2, 4, sheet.getLastRow() - 1, 1)
    .createTextFinder(id).matchEntireCell(true).findNext();
  return cell ? sheet.getRange(cell.getRow(), 1, 1, AREZZI_HEADERS.length).getDisplayValues()[0] : null;
}

function nextId_(sheet, day) {
  var prefix = 'ARZ-' + day.replace(/-/g, '') + '-';
  var last = sheet.getLastRow();
  var ids = last < 2 ? [] : sheet.getRange(2, 1, last - 1, 1).getDisplayValues();
  var max = 0;
  ids.forEach(function(row) {
    var id = row[0];
    if (id.indexOf(prefix) === 0) max = Math.max(max, Number(id.slice(prefix.length)) || 0);
  });
  return prefix + ('0000' + (max + 1)).slice(-4);
}

function saveImage_(image, id) {
  var types = {'image/jpeg':'jpg','image/png':'png','image/webp':'webp'};
  var ext = types[String(image.mimeType || '')];
  if (!ext || !image.base64 || !Number.isFinite(Number(image.size))) throw Error('Invalid image');
  var bytes = Utilities.base64Decode(String(image.base64));
  if (bytes.length > 5 * 1024 * 1024 || bytes.length !== Number(image.size)) throw Error('Invalid image size');
  var b = bytes.map(function(n) { return n & 255; });
  var jpeg = b[0]===255 && b[1]===216 && b[2]===255;
  var png = [137,80,78,71,13,10,26,10].every(function(n,i) { return b[i]===n; });
  var webp = b.slice(0,4).join(',')==='82,73,70,70' && b.slice(8,12).join(',')==='87,69,66,80';
  if (!(ext==='jpg'&&jpeg || ext==='png'&&png || ext==='webp'&&webp)) throw Error('Image content does not match its type');
  var filename = id + '-' + String(image.name || 'reference').replace(/[^A-Za-z0-9._-]/g,'_').slice(0,80);
  if (!filename.toLowerCase().endsWith('.' + ext)) filename += '.' + ext;
  var props = PropertiesService.getScriptProperties();
  var folderId = props.getProperty('referenceFolderId');
  var folder = folderId ? DriveApp.getFolderById(folderId) : DriveApp.createFolder(AREZZI_CFG.referenceFolder);
  if (!folderId) props.setProperty('referenceFolderId',folder.getId());
  var file = folder.createFile(Utilities.newBlob(bytes,image.mimeType,filename));
  return file.getUrl();
}

function senderOptions_() {
  var effective = String(Session.getEffectiveUser().getEmail() || '').toLowerCase();
  var sender = AREZZI_CFG.sender.toLowerCase();
  var options = {name:'Arezzi Furniture', replyTo:AREZZI_CFG.sender};
  if (effective !== sender) {
    if (GmailApp.getAliases().map(function(s) { return s.toLowerCase(); }).indexOf(sender) < 0) {
      throw Error('Arezzi sender is not a verified Gmail Send mail as alias for this account.');
    }
    options.from = AREZZI_CFG.sender;
  }
  return options;
}

function sendDigestEmail_(day, rows) {
  var dateLabel = Utilities.formatDate(new Date(day + 'T12:00:00+05:30'), AREZZI_CFG.timezone, 'dd MMM yyyy');
  var subject = 'Arezzi Furniture | Enquiries for ' + dateLabel + ' | ' + rows.length;
  var options = senderOptions_();
  options.htmlBody = digestHtml_(dateLabel, rows);
  options.inlineImages = {arezziLogo: Utilities.newBlob(
    Utilities.base64Decode(AREZZI_LOGO_BASE64),'image/png','arezzi-logo.png')};
  var plain = 'Arezzi Furniture — enquiries for ' + dateLabel + '\n\n' + rows.map(function(r) {
    return r[0] + ' | ' + r[5] + ' | ' + r[6] + ' | ' + r[10] + '\n' +
      'Area: ' + r[8] + ', ' + r[7] + ' ' + r[9] + '\n' +
      'Home visit: ' + r[11] + '\n' + 'Preferences: ' + [r[12],r[13],r[14],r[16]].filter(Boolean).join('; ') +
      '\nRequirements: ' + r[18] + '\nImage: ' + r[19];
  }).join('\n\n');
  GmailApp.sendEmail(AREZZI_CFG.recipient,subject,plain,options);
}

function digestHtml_(dateLabel, rows) {
  var cards = rows.map(function(r) {
    var phone = normalizePhone_(r[6]);
    var wa = phone.length === 10 ? '91' + phone : phone;
    var call = 'tel:+' + wa;
    var whatsapp = 'https://wa.me/' + wa + '?text=' + encodeURIComponent(
      'Hello ' + r[5] + ', thank you for contacting Arezzi Furniture about your ' + r[10].toLowerCase() + ' enquiry (' + r[0] + ').');
    var fields = [
      ['Name',r[5]],['Phone',r[6]],['District',r[7]],['Area',r[8]],['PIN',r[9]],
      ['Furniture',r[10]],['Home visit requested',r[11]],['Model',r[12]],
      ['Material',r[13]],['Colour',r[14]],['Quantity',r[15]],
      ['Other preferences',r[16]],['Customer email',r[17]],
      ['Requirements',r[18]],['Reference image',r[19]],['Received',r[1]]
    ].filter(function(pair) { return String(pair[1] || '').trim(); });
    var table = fields.map(function(pair, i) {
      var value = pair[0] === 'Reference image' ? '<a href="' + html_(pair[1]) + '" style="color:#94652d">Open image</a>' : html_(pair[1]);
      return '<tr style="background:' + (i%2 ? '#ffffff' : '#f8f3eb') + '"><td style="padding:10px 12px;color:#6a5743;width:34%;border-bottom:1px solid #e8decd">' + html_(pair[0]) + '</td><td style="padding:10px 12px;color:#211c16;border-bottom:1px solid #e8decd">' + value + '</td></tr>';
    }).join('');
    return '<div style="border:1px solid #d4bd98;background:#fff;margin:22px 0;padding:20px">' +
      '<div style="font:22px Georgia,serif;color:#332413;margin-bottom:5px">' + html_(r[5]) + '</div>' +
      '<div style="font:12px Arial,sans-serif;color:#987347;letter-spacing:1px;margin-bottom:15px">ENQUIRY ' + html_(r[0]) + '</div>' +
      '<table cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%;font:13px Arial,sans-serif">' + table + '</table>' +
      '<p style="margin:18px 0 0"><a href="' + call + '" style="background:#1a1b18;color:#efd1a0;text-decoration:none;padding:11px 18px;display:inline-block;margin-right:8px">Call customer</a>' +
      '<a href="' + html_(whatsapp) + '" style="background:#b88a53;color:#17130e;text-decoration:none;padding:11px 18px;display:inline-block">WhatsApp</a></p></div>';
  }).join('');
  return '<div style="background:#eee9df;padding:24px 10px;font-family:Arial,sans-serif"><div style="max-width:700px;margin:auto">' +
    '<div style="background:#111210;text-align:center;padding:25px"><img src="cid:arezziLogo" width="125" height="125" alt="Arezzi Furniture" style="display:block;margin:auto">' +
    '<div style="font:27px Georgia,serif;letter-spacing:3px;color:#edc797">AREZZI FURNITURE</div>' +
    '<div style="font-size:10px;letter-spacing:2px;color:#d3b386;margin-top:8px">SPACES THAT FEEL LIKE YOU</div></div>' +
    '<div style="background:#fffaf2;padding:22px 22px 8px"><div style="font:26px Georgia,serif;color:#251e17">Daily enquiry report</div>' +
    '<div style="font-size:13px;color:#755838;margin-top:6px">' + html_(dateLabel) + ' · ' + rows.length + ' ' + (rows.length===1?'enquiry':'enquiries') + '</div>' +
    '<p style="font-size:13px;color:#5d574f;line-height:1.5">One summary of all enquiries received on this date. Each enquiry was saved to the Arezzi enquiry sheet when submitted.</p>' + cards +
    '<p style="font-size:12px;color:#705b42">View the full <a href="https://docs.google.com/spreadsheets/d/' + AREZZI_CFG.spreadsheetId + '/edit#gid=' + AREZZI_CFG.sheetId + '" style="color:#94652d">enquiry sheet</a>.</p></div>' +
    '<div style="background:#111210;color:#c5ad88;text-align:center;padding:14px;font-size:11px">AREZZI FURNITURE · BENGALURU</div></div></div>';
}

function normalizePhone_(phone) { return String(phone || '').replace(/\D/g,''); }
function safeCell_(value) {
  var s = value === null || value === undefined ? '' : String(value);
  return /^[\s]*[=+\-@\t\r]/.test(s) ? "'" + s : s;
}
function html_(value) {
  return String(value || '').replace(/[&<>"']/g,function(c) {
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}
function json_(value) {
  return ContentService.createTextOutput(JSON.stringify(value))
    .setMimeType(ContentService.MimeType.JSON);
}
